{
  "rest": {
    "RestGenerator": {
      "name": "prompt-injection-engine",
      "uri": "http://127.0.0.1:8900/scan",
      "method": "post",
      "headers": {"Content-Type": "application/json"},
      "req_template_json_object": {"prompt": "$INPUT"},
      "response_json": true,
      "response_json_field": "text"
    }
  }
}
